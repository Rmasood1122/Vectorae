# =============================================================================
# Vectorae — Production Environment Variables
# =============================================================================
# cp .env.production.example .env.production
# Then fill in every value marked REQUIRED before deploying.
#
# NEVER commit .env.production to version control.
# See SECURITY.md for key rotation and secret management procedures.
# =============================================================================

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
APP_ENV=production
LOG_LEVEL=INFO

# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=REQUIRED_change_me_64_hex_chars

# First admin user email (auto-promoted on first registration)
ADMIN_EMAIL=admin@leadpilot.com

# ---------------------------------------------------------------------------
# Encryption (REQUIRED — encrypts integration tokens at rest)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ---------------------------------------------------------------------------
ENCRYPTION_KEY=REQUIRED_fernet_key_here
# Leave blank unless rotating keys (see SECURITY.md)
ENCRYPTION_KEY_PREVIOUS=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
POSTGRES_DB=clienthunter
POSTGRES_USER=clienthunter
POSTGRES_PASSWORD=REQUIRED_strong_db_password

DATABASE_URL=postgresql://clienthunter:REQUIRED_strong_db_password@postgres:5432/clienthunter
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_PASSWORD=REQUIRED_strong_redis_password

REDIS_URL=redis://:REQUIRED_strong_redis_password@redis:6379/0
CELERY_BROKER_URL=redis://:REQUIRED_strong_redis_password@redis:6379/1
CELERY_RESULT_BACKEND=redis://:REQUIRED_strong_redis_password@redis:6379/2

# ---------------------------------------------------------------------------
# Anthropic
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-REQUIRED

# ---------------------------------------------------------------------------
# Apollo.io
# ---------------------------------------------------------------------------
APOLLO_API_KEY=REQUIRED

# ---------------------------------------------------------------------------
# Hunter.io
# ---------------------------------------------------------------------------
HUNTER_API_KEY=REQUIRED

# ---------------------------------------------------------------------------
# Gmail OAuth
# See: https://console.cloud.google.com → Credentials → OAuth 2.0
# ---------------------------------------------------------------------------
GMAIL_CLIENT_ID=REQUIRED.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=REQUIRED
GMAIL_REDIRECT_URI=https://api.leadpilot.com/integrations/gmail/callback

# ---------------------------------------------------------------------------
# WhatsApp Business Cloud API
# See: https://developers.facebook.com → Your App → WhatsApp
# ---------------------------------------------------------------------------
WHATSAPP_PHONE_NUMBER_ID=REQUIRED
WHATSAPP_WABA_ID=REQUIRED
WHATSAPP_ACCESS_TOKEN=REQUIRED  # Use a never-expiring system user token
WHATSAPP_VERIFY_TOKEN=REQUIRED_random_string  # You choose this for webhook verification
WHATSAPP_APP_SECRET=REQUIRED  # From Meta App dashboard → App Settings

# ---------------------------------------------------------------------------
# Calendly
# See: https://developer.calendly.com/api-docs
# ---------------------------------------------------------------------------
CALENDLY_CLIENT_ID=REQUIRED
CALENDLY_CLIENT_SECRET=REQUIRED
CALENDLY_WEBHOOK_SECRET=REQUIRED_random_string

# ---------------------------------------------------------------------------
# Firebase / FCM (push notifications)
# See: https://console.firebase.google.com → Project Settings → Service Accounts
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=REQUIRED
# Paste the entire contents of your Firebase service account JSON, on one line
FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"REQUIRED",...}

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
# PUBLIC_BASE_URL is the origin that UNSUBSCRIBE LINKS, WhatsApp opt-in links
# and media URLs are built from (app/services/sequence_engine.py,
# app/api/whatsapp_optin.py, app/api/auth.py). It was missing from this file
# entirely, so production would have inherited the http://localhost:8000
# default and shipped real marketing email with an unsubscribe link no
# recipient could use — a CAN-SPAM violation and a fast route to the spam
# folder. app/core/production_guard.py now refuses to start without it.
PUBLIC_BASE_URL=https://api.leadpilot.com

# SENDER_IDENTITY is the physical postal address in the CAN-SPAM footer of
# every outbound email. The code default is the literal placeholder
# "Vectorae User, 123 Main St, City, Country". REPLACE THIS WITH A REAL
# POSTAL ADDRESS — the guard rejects the placeholder.
SENDER_IDENTITY=Vectorae, <street>, <city>, <postcode>, <country>

FRONTEND_URL=https://leadpilot.com

# CORS_ORIGINS: PLAIN COMMA-SEPARATED LIST. Not a JSON array.
# app/main.py parses this with `os.getenv("CORS_ORIGINS").split(",")`, so a
# JSON array like ["https://a.com","https://b.com"] splits into fragments such
# as '["https://a.com"' which never match a browser's Origin header. The API
# still returns 200 and every healthcheck passes -- only the browser fails,
# with a CORS error and no server-side trace. This file documented the JSON
# form until 2026-08-20; it was verified broken against a live server.
# app/core/production_guard.py now refuses to start production if brackets or
# quotes appear here.
CORS_ORIGINS=https://leadpilot.com,https://www.leadpilot.com

# NEXT_PUBLIC_API_URL is BAKED INTO THE FRONTEND AT BUILD TIME.
# The frontend is a Next.js static export (for Capacitor mobile bundling), so
# this value is compiled into the JS bundle -- it CANNOT be changed by editing
# an env var and restarting. Changing it requires a full frontend rebuild and
# redeploy. Build once per target environment.
NEXT_PUBLIC_API_URL=https://api.leadpilot.com

# ---------------------------------------------------------------------------
# Rate limits
# ---------------------------------------------------------------------------
# These were previously absent from this file, so production silently inherited
# the defaults in app/core/config.py. They are listed explicitly now so they can
# be tuned without reading source.
#
# RATE_LIMIT_STRATEGIES is the one to revisit first once real usage is known.
# Lowered 10 -> 2 on 2026-08-20. Each strategy is a 72/144-step Anthropic
# pipeline plus 10 verification passes — the Phase C run measured ~150 Claude
# calls and ~72 minutes of worker time for a SINGLE strategy. At 10/hour it was
# the most permissive limit in the system while being the most expensive
# operation, and it exceeded what one pipeline worker can physically execute.
# 2 still allows an immediate retry after a misconfigured product.
# Raise it here (and in app/core/config.py's default) once usage is understood.
RATE_LIMIT_STRATEGIES=2
RATE_LIMIT_LEADS_SOURCE=5
RATE_LIMIT_PLAYBOOK_RECOMPUTE=3
RATE_LIMIT_WA_TEMPLATES=20
RATE_LIMIT_GET=300
RATE_LIMIT_AUTH=10

# ---------------------------------------------------------------------------
# Circuit breaker tuning
# ---------------------------------------------------------------------------
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=60

# ---------------------------------------------------------------------------
# Pipeline monitoring
# ---------------------------------------------------------------------------
PIPELINE_STEP_TIMEOUT_MINUTES=10

# ---------------------------------------------------------------------------
# Learning loop
# ---------------------------------------------------------------------------
PLAYBOOK_MIN_SAMPLE=30
AB_MIN_LIFT=0.10
AB_SIGNIFICANCE_THRESHOLD=0.05

# ---------------------------------------------------------------------------
# Sending limits
# ---------------------------------------------------------------------------
GMAIL_DAILY_CAP=100
GMAIL_WARMUP_START_SENDS=10
GMAIL_WARMUP_DAILY_INCREMENT=10
BOUNCE_RATE_PAUSE_THRESHOLD=0.03
BOUNCE_MIN_SENDS=10

# ---------------------------------------------------------------------------
# Android
# ---------------------------------------------------------------------------
ANDROID_PACKAGE_NAME=io.clienthunter.app

# ---------------------------------------------------------------------------
# Email delivery — signup verification (Feature 1)
# ---------------------------------------------------------------------------
# PRODUCTION MUST NOT USE console OR memory. Both accept the send and deliver
# nothing, so signup keeps returning 201 while no user ever receives a link --
# a failure no health check can see.
EMAIL_PROVIDER=resend

# Domain must be VERIFIED in Resend (SPF + DKIM records published) before any
# mail reaches an inbox rather than a spam folder.
EMAIL_FROM=noreply@calendarharvest.com
EMAIL_FROM_NAME=Vectorae

# Secret. Paste in the Render dashboard; never commit it.
RESEND_API_KEY=

EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60

# Leave true. Setting false disables signup verification platform-wide.
REQUIRE_EMAIL_VERIFICATION=true

# ---------------------------------------------------------------------------
# AI support chat (Feature 3)
# ---------------------------------------------------------------------------
# KILL SWITCH. false -> POST /support/chat returns 503 and the widget offers
# tickets only. The lever to pull if the assistant ever says something it
# should not; no deploy required.
SUPPORT_CHAT_ENABLED=true

# Below this self-reported confidence the answer is DISCARDED and the user is
# offered a ticket instead. A hedged wrong answer still reads as an answer.
SUPPORT_CHAT_MIN_CONFIDENCE=0.5

# Output ceiling for one reply, and how many prior turns are replayed for
# context. History is re-sent on every message, so the second value is a
# direct multiplier on input cost.
SUPPORT_CHAT_MAX_TOKENS=1024
SUPPORT_CHAT_HISTORY_TURNS=6

# Chat history is deleted after this many days by the nightly purge (03:20
# UTC). Support tickets are NEVER purged. 0 disables the purge.
SUPPORT_CHAT_RETENTION_DAYS=30

# Help AI v2: Voyage embeddings + rerank for help-center retrieval
# (app/services/embeddings_client.py; DECISIONS HELPAI-VENDOR / HELPAI-RERANK).
# Empty key: the help-center index is text-only and retrieval stays BM25.
# EMBEDDINGS_MODE works like AI_MODE: empty = auto (live with a key, mock
# without); "mock" = deterministic hash vectors, no network.
VOYAGE_API_KEY=
EMBEDDINGS_MODE=

# Messages per user per DAY. Every message spends ANTHROPIC_API_KEY, so this
# is a cost ceiling as much as an abuse control. NOTE: read from
# app/core/config.py, not app/config.py.
RATE_LIMIT_SUPPORT_CHAT=30

# ---------------------------------------------------------------------------
# Native CRM (M9)
# ---------------------------------------------------------------------------
# CRM writes per user per HOUR: inline grid cell edits, notes, tags, saved
# views, custom fields. Deliberately the loosest limit in this file, because
# it is the only one whose operation costs nothing external -- every other
# RATE_LIMIT_* here is a spend ceiling (Anthropic calls, Apollo/Hunter
# credits); a CRM write is one row in PostgreSQL.
#
# 600/hour is 10/minute sustained. The traffic it governs is somebody working
# a list of leads: type a value, tab, type again. A limit tight enough to
# catch abuse would mostly catch that person instead, with a 429 halfway
# through a row. One bulk call touches up to 500 leads and costs ONE slot, so
# the efficient path is also the cheap one. NOTE: read from
# app/core/config.py, not app/config.py.
RATE_LIMIT_CRM_WRITE=600

# How long ONE Server-Sent Events connection (GET /crm/stream) is held before
# the server asks the client to reconnect. Not a failure timeout -- the stream
# is working when it fires. An SSE connection is a worker slot held for as
# long as the tab is open, and a dashboard left up over a weekend would
# otherwise hold one across a deploy and every transient in between. The
# browser's EventSource reconnects on its own (re-minting a stream ticket
# first), so cycling costs the user nothing.
#
# SET TO 0 TO TURN REAL-TIME OFF ENTIRELY. GET /crm/stream then answers 503
# and every client falls back to polling -- the lever to pull if the stream
# ever misbehaves, with no deploy needed.
CRM_STREAM_MAX_SECONDS=3600

# ---------------------------------------------------------------------------
# Tool Integrations — AegisAudit / PostIQ / SIGNALFORGE
# ---------------------------------------------------------------------------
# NOT read from the environment. These are stored in the database
# (tool_integration_settings, migration 0032) and set at runtime through the
# /integrations/tools/* endpoints. Secrets are encrypted with ENCRYPTION_KEY.
# Listed here for documentation only.
#
# AegisAudit (admin, PUT /integrations/tools/aegisaudit) — draft quality audit
# default_mode: standard | deep | forensic | maximum
# AEGISAUDIT_HOST=127.0.0.1
# AEGISAUDIT_PORT=8787
#
# PostIQ (per user, PUT /integrations/tools/postiq) — the Web App URL must be
# https://script.google.com/macros/s/<id>/exec; the token is encrypted and
# sent in the request body (Apps Script cannot read headers). PostIQ has no
# API to read drafts; it delivers them itself on Telegram / WhatsApp.
#
# SIGNALFORGE (admin, PUT /integrations/tools/signalforge) — prospect research
# SIGNALFORGE_BASE_URL=http://127.0.0.1:8000
# SIGNALFORGE_OPERATOR_KEY=
# Vectorae's key uses SIGNALFORGE's default scopes only (READ, RESEARCH,
# AI_GENERATION). Prospects must already exist in SIGNALFORGE -- Vectorae
# researches by prospect_id and never creates them. Never grant WRITE,
# APPROVAL or SEND to Vectorae's key.

# ---------------------------------------------------------------------------
# Identity, VPN blocking, phone verification (migration 0039)
# ---------------------------------------------------------------------------
GEOLOCATION_PROVIDER=ipapi_co
GEOLOCATION_API_KEY=
# Unset defaults to ON in production; stated explicitly here.
VPN_BLOCK_ENABLED=true
VPN_DETECTION_PROVIDER=proxycheck
VPN_DETECTION_API_KEY=REQUIRED_for_more_than_1000_lookups_per_day
VPN_DETECTION_FAIL_CLOSED=false
VPN_ALLOWLIST_IPS=
# P0-D-ENF. Single-tenant deployment: close self-registration, or limit it to
# the customer's own email domains. Default (unset) is OPEN to anyone; decide
# per deployment (docs/program/DECISIONS.md P0-D-ENF).
SIGNUP_ENABLED=true
SIGNUP_ALLOWED_EMAIL_DOMAINS=
# Email + push every admin on each new account (Admin > Sign-ups lists them).
SIGNUP_ALERTS_ENABLED=true
# Claude / ChatGPT connector (docs/features/mcp-connector.md). Leave off until
# the OAuth authorization server is deployed (connector Phase 2).
MCP_ENABLED=false
MCP_RESOURCE_URL=https://api.calendarharvest.com/mcp
# PRODUCTION MUST NOT USE console OR memory: codes would never arrive.
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=REQUIRED
TWILIO_AUTH_TOKEN=REQUIRED
TWILIO_FROM_NUMBER=REQUIRED_E164_or_MG_messaging_service_sid
REQUIRE_PHONE_VERIFICATION=true
RATE_LIMIT_OTP_SEND=5
RATE_LIMIT_OTP_VERIFY=10

# ---------------------------------------------------------------------------
# Billing — Stripe (migration 0040)
# ---------------------------------------------------------------------------
# Empty = stub mode (nobody is charged). Never leave empty in production.
STRIPE_SECRET_KEY=sk_live_REQUIRED
STRIPE_WEBHOOK_SECRET=whsec_REQUIRED

# Audit-trail export signing key (base64 32-byte seed). Set explicitly in
# production so rotating SECRET_KEY never invalidates signed reports.
AUDIT_SIGNING_KEY=REQUIRED_base64_32_bytes
RATE_LIMIT_PUBLIC_SHARE=120
RATE_LIMIT_PUBLIC_STATUS=600
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_SCALE=
STRIPE_PRICE_ENTERPRISE=
# Annual plans (interval year). If set, the amount MUST be monthly x
# ANNUAL_MONTHS_CHARGED (app/core/billing_catalog.py); unset = inline price.
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_GROWTH_ANNUAL=
STRIPE_PRICE_SCALE_ANNUAL=
STRIPE_PRICE_ENTERPRISE_ANNUAL=
