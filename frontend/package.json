{
  "name": "clienthunter-web",
  "version": "0.7.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "postbuild": "node scripts/seo/check_static_seo.mjs --postbuild",
    "start": "next start",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "next build --webpack && playwright test",
    "test:e2e:no-build": "playwright test",
    "serve:export": "node scripts/static-server.js",
    "mobile:build": "next build --webpack && npx cap sync android",
    "mobile:open": "npx cap open android",
    "mobile:run": "next build --webpack && npx cap sync android && npx cap run android",
    "mobile:sync": "npx cap sync android",
    "mobile:lint": "npx cap doctor",
    "mobile:assets": "scripts\\generate-assets.cmd",
    "mobile:build:dev": "cross-env NEXT_PUBLIC_API_URL=http://10.0.2.2:8000 NEXT_PUBLIC_BUILD_TARGET=mobile-dev next build --webpack && npx cap sync android",
    "mobile:build:prod": "cross-env NEXT_PUBLIC_BUILD_TARGET=mobile-prod next build --webpack && npx cap sync android"
  },
  "dependencies": {
    "@capacitor/app": "^6.0.1",
    "@capacitor/core": "^6.1.2",
    "@capacitor/haptics": "^6.0.1",
    "@capacitor/network": "^6.0.2",
    "@capacitor/preferences": "^6.0.3",
    "@capacitor/push-notifications": "^6.0.2",
    "@capacitor/splash-screen": "^6.0.2",
    "@capacitor/status-bar": "^6.0.1",
    "@radix-ui/react-alert-dialog": "^1.1.1",
    "@radix-ui/react-avatar": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.1",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-scroll-area": "^1.1.0",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.1.2",
    "@tanstack/react-query": "^5.40.0",
    "@tanstack/react-query-devtools": "^5.40.0",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.407.0",
    "next": "16.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7",
    "sonner": "^2.0.8",
    "tailwind-merge": "^2.4.0"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.2",
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0",
    "@playwright/test": "^1.45.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^5.0.5",
    "autoprefixer": "^10.4.19",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.35",
    "jsdom": "^24.1.1",
    "msw": "^2.3.1",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.5.3",
    "vitest": "^5.0.5"
  }
}
