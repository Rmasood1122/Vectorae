# Vectorae — .env.example
# Copy to .env and fill in values. Never commit .env to version control.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
APP_ENV=development                     # development | production | testing
SECRET_KEY=change-me-in-production      # Random 32-byte string for JWT signing
# Persistent sign-in. Web clients get the refresh token as an HttpOnly cookie
# (app/services/auth_sessions.py). 30-day sliding window by default.
# JWT_REFRESH_TTL_SECONDS=2592000
# AUTH_EPHEMERAL_SESSION_TTL_SECONDS=43200  # "keep me signed in" unticked
# AUTH_REFRESH_COOKIE_PATH=/auth            # /api/v1/auth behind a path-prefix proxy
# AUTH_REFRESH_COOKIE_DOMAIN=               # empty = host-only
# AUTH_REFRESH_COOKIE_SAMESITE=lax          # none when frontend and API are different sites
# AUTH_REFRESH_COOKIE_SECURE=               # empty = Secure in production only
# AUTH_ACCEPT_LEGACY_REFRESH_TOKENS=true    # set false 30 days after deploying sessions
LOG_LEVEL=INFO
ADMIN_EMAIL=you@example.com             # Receives system alert emails

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/clienthunter

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
# Host-side dev config. docker-compose.yml publishes this project's Redis on
# 6380, NOT 6379, because 6379 was already taken on the dev host by an
# unrelated project. Pointing at 6379 silently shares that other project's
# Redis: the response cache, circuit-breaker state AND the Celery broker
# all end up in someone else's instance (verified - it was already holding
# this app's cache:apollo:* / cache:hunter:* / learning_loop:* keys).
# In production these use the compose hostname instead - see
# .env.production.example, which is correct as written.
REDIS_URL=redis://localhost:6380/0
CELERY_BROKER_URL=redis://localhost:6380/1
CELERY_RESULT_BACKEND=redis://localhost:6380/2

# ---------------------------------------------------------------------------
# AI
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...            # Anthropic API key
ANTHROPIC_MODEL=claude-sonnet-4-6       # Model used for all pipeline steps

# ---------------------------------------------------------------------------
# Integrations
# ---------------------------------------------------------------------------
APOLLO_API_KEY=                         # Apollo.io API key
HUNTER_API_KEY=                         # Hunter.io API key

# Gmail OAuth 2.0
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8000/integrations/gmail/callback

# WhatsApp Business Cloud API (Meta)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=                  # Random string you choose for Meta webhook verification
WHATSAPP_APP_SECRET=                    # From Meta App → Settings → Basic → App Secret

# Calendly
CALENDLY_CLIENT_ID=
CALENDLY_CLIENT_SECRET=
CALENDLY_WEBHOOK_SECRET=                # Random string for HMAC validation

# Firebase (Android push notifications)
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_JSON={}            # Service account JSON as a string

# ---------------------------------------------------------------------------
# Encryption
# ---------------------------------------------------------------------------
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
ENCRYPTION_KEY_PREVIOUS=               # Optional: previous key for rotation

# ---------------------------------------------------------------------------
# Compliance / Sending limits
# ---------------------------------------------------------------------------
# The names app/config.py reads (the old GMAIL_DAILY_SEND_CAP,
# GMAIL_BOUNCE_PAUSE_THRESHOLD and GMAIL_WARMUP_START_DAILY were read by nothing).
GMAIL_DAILY_CAP=100                    # Hard cap per Gmail account per day
GMAIL_WARMUP_START_SENDS=10            # A new mailbox starts at 10 emails/day...
GMAIL_WARMUP_DAILY_INCREMENT=10        # ...plus 10 per day since it was connected, up to the cap
BOUNCE_RATE_PAUSE_THRESHOLD=0.03       # Pause a campaign when its bounce rate is above 3%
BOUNCE_MIN_SENDS=10                    # ...once it has at least this many sends

# ---------------------------------------------------------------------------
# Learning loop (M8-C1/C2)
# ---------------------------------------------------------------------------
PLAYBOOK_MIN_SAMPLE=30                 # Minimum sends before a pattern is "reliable"
AB_MIN_LIFT=0.10                       # Min relative lift to declare an A/B winner (10%)
AB_SIGNIFICANCE_THRESHOLD=0.05
AB_HARM_CEILING=0.05                   # A/B: max harm-metric rate (bounce+spam+opt-out per send) before promotion is blocked
PLAYBOOK_AGGREGATION_UTC_HOUR=2        # Hour (UTC) for nightly learning job (default 2 = 07:00 PKT)

# ---------------------------------------------------------------------------
# Score decay (M8-C4)
# ---------------------------------------------------------------------------
PLAYBOOK_SCORE_HALF_LIFE_DAYS=90       # Outcomes from N days ago count half as much as today
                                        # Lower = faster forgetting; higher = more historical weight
                                        # Recommended range: 30–180

# ---------------------------------------------------------------------------
# Multi-variate testing (M8-C4)
# ---------------------------------------------------------------------------
MV_MAX_VARIANTS=5                      # Maximum number of A/B/C/D/E variants per strategy

# ---------------------------------------------------------------------------
# Rate limiting (M8-C5) — calls per user per window
# ---------------------------------------------------------------------------
RATE_LIMIT_STRATEGIES=2               # POST /products/*/strategies per user per HOUR
RATE_LIMIT_LEADS_SOURCE=5              # POST /strategies/*/leads/source per user per HOUR
RATE_LIMIT_PLAYBOOK_RECOMPUTE=3        # POST /admin/playbook/recompute per admin per HOUR
RATE_LIMIT_WA_TEMPLATES=20             # POST /whatsapp/templates/* per user per HOUR
RATE_LIMIT_GET=300                     # GET endpoints per user per MINUTE
RATE_LIMIT_AUTH=10                     # POST /auth/* per IP per 15-MINUTE window

# ---------------------------------------------------------------------------
# Pipeline monitoring (M8-C3)
# ---------------------------------------------------------------------------
PIPELINE_STEP_TIMEOUT_MINUTES=10       # Alert if a pipeline step takes longer than this

# ---------------------------------------------------------------------------
# Circuit breaker (M8-C3)
# ---------------------------------------------------------------------------
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5    # Open circuit after N consecutive failures
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=60   # Seconds before retrying a half-open circuit

# ---------------------------------------------------------------------------
# Frontend / CORS
# ---------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
# Plain comma-separated list, NOT a JSON array: app/main.py splits this on
# commas, so brackets/quotes become part of the origin and never match a
# browser Origin header. Inert locally (nothing loads .env into os.environ)
# but real in Docker/Railway, where these become actual env vars.
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Email delivery — signup verification (Feature 1)
# ---------------------------------------------------------------------------
# EMAIL_PROVIDER is EXPLICIT, never inferred from which keys happen to be set.
# A production process with a misspelled key name must fail loudly at send
# time, not quietly log every user's verification link to stdout.
#   resend  - HTTPS POST to api.resend.com          (production)
#   smtp    - plain SMTP; Mailtrap sandbox locally  (testing)
#   console - log the message, deliver nothing      (dev with no credentials)
#   memory  - in-process list                       (the pytest suite)
EMAIL_PROVIDER=console

# The From address. MUST be on a domain verified in the Resend dashboard, or
# messages are accepted by the API and then dropped or spam-foldered.
EMAIL_FROM=noreply@calendarharvest.com
EMAIL_FROM_NAME=Vectorae

# --- Resend (EMAIL_PROVIDER=resend) ---
RESEND_API_KEY=

# --- SMTP / Mailtrap sandbox (EMAIL_PROVIDER=smtp) ---
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# Verification link lifetime, in hours. 24 is the product requirement.
EMAIL_VERIFICATION_TTL_HOURS=24

# Password-reset link lifetime, in minutes (docs/features/password-reset.md).
# The link is emailed to FRONTEND_URL/reset-password, so FRONTEND_URL must be
# the public web app origin wherever a real person resets a password.
PASSWORD_RESET_TTL_MINUTES=60

# KILL SWITCH. While true, get_current_user rejects any unverified account on
# EVERY authenticated route. Set false to disable enforcement without a code
# change or redeploy -- the escape hatch if verification ever locks real users
# out of a running system.
REQUIRE_EMAIL_VERIFICATION=true

# PUBLIC_BASE_URL is the origin baked into the verification link itself.
# It must be the PUBLIC origin of THIS API, reachable from a mail client.
# Left at localhost in a deployed environment, every emailed link is dead.
PUBLIC_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Identity & location verification at onboarding (migration 0039)
# ---------------------------------------------------------------------------
# Declared personal country vs IP geolocation. A mismatch is flagged for admin
# review (/admin/identity-reviews); it NEVER blocks signup.
#   ipapi_co  no key, ~1k lookups/day   |   ipinfo  token below   |   disabled
GEOLOCATION_PROVIDER=ipapi_co
GEOLOCATION_API_KEY=

# ---------------------------------------------------------------------------
# VPN / proxy / Tor / datacenter blocking at signup + login
# ---------------------------------------------------------------------------
# Leave VPN_BLOCK_ENABLED unset for "on in production, off elsewhere".
VPN_BLOCK_ENABLED=
#   proxycheck (key optional, ~1k/day without) | ipqualityscore (key) | disabled
VPN_DETECTION_PROVIDER=proxycheck
VPN_DETECTION_API_KEY=
# false = when the provider is down, let the request through (logged)
VPN_DETECTION_FAIL_CLOSED=false
VPN_DETECTION_CACHE_SECONDS=3600
# Comma-separated IPs never blocked (an office egress misclassified as hosting)
VPN_ALLOWLIST_IPS=

# ---------------------------------------------------------------------------
# Public sign-up (P0-D-ENF; one customer organisation per deployment)
# ---------------------------------------------------------------------------
# false = nobody can self-register (accounts come from the admin CLI only)
SIGNUP_ENABLED=true
# Comma-separated exact email domains allowed to register; empty = any domain
SIGNUP_ALLOWED_EMAIL_DOMAINS=

# ---------------------------------------------------------------------------
# Phone verification (SMS one-time code)
# ---------------------------------------------------------------------------
#   twilio | console (logs a masked notice, sends nothing) | memory (tests)
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=                    # E.164 number, or an MG... Messaging Service SID
PHONE_OTP_TTL_SECONDS=600
PHONE_OTP_MAX_ATTEMPTS=5
PHONE_OTP_RESEND_COOLDOWN_SECONDS=60
# KILL SWITCH: false lets post-0039 accounts launch outreach / buy a plan /
# share dashboards without a verified phone.
REQUIRE_PHONE_VERIFICATION=true
# NOTE: read from app/core/config.py, not app/config.py.
RATE_LIMIT_OTP_SEND=5                  # codes per HOUR, per account AND per number
RATE_LIMIT_OTP_VERIFY=10               # verify attempts per 15 MINUTES per account

# ---------------------------------------------------------------------------
# Billing — Stripe (monthly subscriptions + pay-per-meeting)
# ---------------------------------------------------------------------------
# EMPTY SECRET KEY = STUB MODE: plans activate locally and meetings are marked
# charged, all flagged is_stub. Nothing is charged. See BUILD_BLOCKERS.md.
STRIPE_SECRET_KEY=
# whsec_... for the /webhooks/stripe endpoint. Empty = that endpoint answers 503.
STRIPE_WEBHOOK_SECRET=
# Optional pre-created recurring Price ids; unset = inline prices from
# app/core/billing_catalog.py.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_SCALE=
STRIPE_PRICE_ENTERPRISE=
# Annual plans (interval year). If set, the amount MUST be monthly x
# ANNUAL_MONTHS_CHARGED (app/core/billing_catalog.py); unset = inline price.
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_GROWTH_ANNUAL=
STRIPE_PRICE_SCALE_ANNUAL=
STRIPE_PRICE_ENTERPRISE_ANNUAL=

# ---------------------------------------------------------------------------
# Tamper-evident audit trail + public share links (Features A2, A6)
# ---------------------------------------------------------------------------
# Base64 of a 32-byte Ed25519 seed that signs audit-trail exports. EMPTY =
# derived from SECRET_KEY. Set it explicitly BEFORE ever rotating SECRET_KEY,
# or reports signed earlier stop verifying against GET /audit/public-key.
# Generate: python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
AUDIT_SIGNING_KEY=
# Public ROI dashboard views and /audit/verify calls per client IP per HOUR.
# NOTE: read from app/core/config.py, not app/config.py.
RATE_LIMIT_PUBLIC_SHARE=120
# GET /status/public (status.calendarharvest.com) calls per client IP per HOUR.
# NOTE: read from app/core/config.py, not app/config.py.
RATE_LIMIT_PUBLIC_STATUS=600

# ---------------------------------------------------------------------------
# Android
# ---------------------------------------------------------------------------
ANDROID_PACKAGE_NAME=com.clienthunter.app

# ---------------------------------------------------------------------------
# AI support chat (Feature 3)
# ---------------------------------------------------------------------------
# KILL SWITCH. false -> POST /support/chat returns 503 and the widget offers
# tickets only. The lever to pull if the assistant ever says something it
# should not; no deploy required.
SUPPORT_CHAT_ENABLED=true

# AI_MODE — console | mock | live. LEAVE EMPTY FOR AUTO (recommended).
#   auto (empty)  live when ANTHROPIC_API_KEY is set, mock when it is not
#   mock          answers from the curated FAQ only; NO Anthropic call is ever
#                 made, so this costs nothing. No FAQ match offers a ticket.
#   console       identical to mock, and additionally logs each question, the
#                 matched entry and the score at INFO — for seeing WHY mock
#                 mode answered the way it did, locally.
#   live          always calls Anthropic. Fails loudly on a bad key rather
#                 than silently degrading, which is what you want in
#                 production once the key is real.
# History, the daily cap and ticket creation behave the same in every mode.
AI_MODE=

# Help AI v2: Voyage embeddings + rerank for help-center retrieval
# (app/services/embeddings_client.py; DECISIONS HELPAI-VENDOR / HELPAI-RERANK).
# Empty key: the help-center index is text-only and retrieval stays BM25.
# EMBEDDINGS_MODE works like AI_MODE: empty = auto (live with a key, mock
# without); "mock" = deterministic hash vectors, no network.
VOYAGE_API_KEY=
EMBEDDINGS_MODE=

# Below this self-reported confidence the answer is DISCARDED and the user is
# offered a ticket instead. A hedged wrong answer still reads as an answer.
SUPPORT_CHAT_MIN_CONFIDENCE=0.5

# Output ceiling for one reply, and how many prior turns are replayed for
# context. History is re-sent on every message, so the second value is a
# direct multiplier on input cost.
SUPPORT_CHAT_MAX_TOKENS=1024
SUPPORT_CHAT_HISTORY_TURNS=6

# Chat history is deleted after this many days by the nightly purge (03:20
# UTC). Support tickets are NEVER purged. 0 disables the purge.
SUPPORT_CHAT_RETENTION_DAYS=30

# Messages per user per DAY. Every LIVE message spends ANTHROPIC_API_KEY, so
# this is a cost ceiling as much as an abuse control. Enforced identically in
# mock mode, where a message costs nothing, so that the limit does not tighten
# on users the day a real key is added. NOTE: read from app/core/config.py,
# not app/config.py.
RATE_LIMIT_SUPPORT_CHAT=20

# ---------------------------------------------------------------------------
# Native CRM (M9)
# ---------------------------------------------------------------------------
# CRM writes per user per HOUR: inline grid cell edits, notes, tags, saved
# views, custom fields. Deliberately the loosest limit in this file, because
# it is the only one whose operation costs nothing external -- every other
# RATE_LIMIT_* here is a spend ceiling (Anthropic calls, Apollo/Hunter
# credits); a CRM write is one row in PostgreSQL.
#
# 600/hour is 10/minute sustained. The traffic it governs is somebody working
# a list of leads: type a value, tab, type again. A limit tight enough to
# catch abuse would mostly catch that person instead, with a 429 halfway
# through a row. One bulk call touches up to 500 leads and costs ONE slot, so
# the efficient path is also the cheap one. NOTE: read from
# app/core/config.py, not app/config.py.
RATE_LIMIT_CRM_WRITE=600

# How long ONE Server-Sent Events connection (GET /crm/stream) is held before
# the server asks the client to reconnect. Not a failure timeout -- the stream
# is working when it fires. An SSE connection is a worker slot held for as
# long as the tab is open, and a dashboard left up over a weekend would
# otherwise hold one across a deploy and every transient in between. The
# browser's EventSource reconnects on its own (re-minting a stream ticket
# first), so cycling costs the user nothing.
#
# SET TO 0 TO TURN REAL-TIME OFF ENTIRELY. GET /crm/stream then answers 503
# and every client falls back to polling -- the lever to pull if the stream
# ever misbehaves, with no deploy needed.
CRM_STREAM_MAX_SECONDS=3600

# ---------------------------------------------------------------------------
# Engagement Hub — calendar, meetings, automated follow-up
# ---------------------------------------------------------------------------

# --- Worker sweeps and the database ----------------------------------------
# Celery beat runs every frequent database sweep (dispatch, reply polling,
# follow-ups, meeting reminders, plan holds, CRM sync, attribution...) together,
# once every BEAT_SWEEP_MINUTES, and leaves the database alone in between, so
# a database that suspends when idle (Neon's free plan) can sleep. Must divide
# 60, minimum 5. Lower it for faster sends and reply pickup when idle time is
# not billed.
BEAT_SWEEP_MINUTES=30
# /health and /status/public reuse a successful database check for this many
# seconds (Render probes /health every few seconds). A failed check is never
# reused. 0 = query the database on every request.
HEALTH_DB_CHECK_TTL_SECONDS=1800

# --- Feature 1: automated follow-up ----------------------------------------
# The follow-up sweep runs in every worker burst (BEAT_SWEEP_MINUTES above).

# TTL on the Redis lock one follow-up send holds (followup:{enrollment}:{step}).
# Two hours: far longer than any send takes, far shorter than the shortest
# useful follow-up delay, so a crashed worker's lock cannot survive to block
# the next legitimate attempt. Note the lock is an optimisation, not the
# guarantee -- the message row's SCHEDULED -> SENDING claim is what actually
# makes a double send impossible, and it works with Redis down.
FOLLOWUP_LOCK_TTL_SECONDS=7200

# --- Feature 2: the self-built calendar ------------------------------------
# How far ahead a public booking page offers slots, and the width of the
# window every slot query scans. This is the one knob that trades "book me in
# three months" against the cost of an unauthenticated request.
CALENDAR_SLOT_DAYS_AHEAD=30

# A slot closer than this is never offered. Without it the booking page will
# happily sell your next hour to a stranger while you are in another meeting.
CALENDAR_MIN_NOTICE_MINUTES=60

# Public booking writes per IP per hour. The one write in this API an
# unauthenticated stranger can make, so it is the one that needs an IP-scoped
# ceiling: unlimited, a booking page is a free way to fill a founder's
# calendar with junk and send confirmation emails from OUR domain, which is a
# deliverability problem as much as a nuisance. The SLOTS endpoint is
# deliberately not limited -- it is a read, and the page calls it on every
# date click. NOTE: read from app/core/config.py, not app/config.py.
RATE_LIMIT_PUBLIC_BOOKING=30

# Authenticated calendar and meeting writes per user per hour. Sized above the
# meeting-notes autosave (once per 10s per open meeting = 360/hour for someone
# in back-to-back calls all day).
# NOTE: read from app/core/config.py, not app/config.py.
RATE_LIMIT_CALENDAR_WRITE=300

# --- Feature 3: meeting platforms ------------------------------------------
# Google Calendar event creation (which is the ONLY way to mint a Google Meet
# link -- there is no "create a Meet link" API). Deliberately separate from
# GOOGLE_CLIENT_ID/SECRET above: that pair is the Gmail send credential scoped
# to gmail.send, and a calendar event needs calendar.events. In practice both
# come from the same Google Cloud project.
#
# NOTE ON EXISTING CONNECTIONS: the calendar.events scope was added to the
# Gmail OAuth request when this feature shipped. An account connected BEFORE
# that does not gain the scope retroactively -- Google answers 403 and the
# adapter tells the user to reconnect at /integrations/gmail/auth-url.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Zoom SERVER-TO-SERVER OAuth (not the user-consent flow). Authorise once in
# the Zoom marketplace app; every meeting is then created under that account.
# All three are required together -- the token request fails with an opaque
# 400 if the account id is missing.
ZOOM_OAUTH_CLIENT_ID=
ZOOM_OAUTH_CLIENT_SECRET=
ZOOM_ACCOUNT_ID=

# HMAC-SHA256 secret for POST /meetings/{id}/transcript, the endpoint a
# browser extension or a recording provider (Recall.ai and similar) streams
# transcript chunks to. Neither can hold a user JWT, so it authenticates by
# signature over the raw request body instead.
#
# EMPTY MEANS THE ENDPOINT IS CLOSED (503), not open. A transcript is the
# verbatim content of a private sales call, and an unauthenticated write path
# to it that appears by default is not a trade-off worth making. Generate one
# with: python -c "import secrets; print(secrets.token_hex(32))"
MEETING_RECORDING_WEBHOOK_SECRET=

# Output ceiling for one AI meeting summary. Larger than SUPPORT_CHAT_MAX_TOKENS
# because this call returns five structured fields over a full transcript, and
# a truncated summary is a summary with the action items missing.
MEETING_AI_MAX_TOKENS=4096

# ---------------------------------------------------------------------------
# Tool Integrations — AegisAudit / PostIQ / SIGNALFORGE
# ---------------------------------------------------------------------------
# NOT read from the environment. These are stored in the database
# (tool_integration_settings, migration 0032) and set at runtime through the
# /integrations/tools/* endpoints. Secrets are encrypted with ENCRYPTION_KEY.
# Listed here for documentation only.
#
# AegisAudit (admin, PUT /integrations/tools/aegisaudit) — draft quality audit
# default_mode: standard | deep | forensic | maximum
# AEGISAUDIT_HOST=127.0.0.1
# AEGISAUDIT_PORT=8787
#
# PostIQ (per user, PUT /integrations/tools/postiq) — the Web App URL must be
# https://script.google.com/macros/s/<id>/exec; the token is encrypted and
# sent in the request body (Apps Script cannot read headers). PostIQ has no
# API to read drafts; it delivers them itself on Telegram / WhatsApp.
#
# SIGNALFORGE (admin, PUT /integrations/tools/signalforge) — prospect research
# SIGNALFORGE_BASE_URL=http://127.0.0.1:8000
# SIGNALFORGE_OPERATOR_KEY=
# Vectorae's key uses SIGNALFORGE's default scopes only (READ, RESEARCH,
# AI_GENERATION). Prospects must already exist in SIGNALFORGE -- Vectorae
# researches by prospect_id and never creates them. Never grant WRITE,
# APPROVAL or SEND to Vectorae's key.
